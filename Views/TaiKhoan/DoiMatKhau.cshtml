@model BookStoreManagement.Models.DoiMatKhauViewModel

@{
    ViewData["Title"] = "Đổi mật khẩu";
    // Nhớ đổi dòng dưới đây cho giống với khai báo Layout bên trang HoSoCaNhan.cshtml nhé!
    Layout = "~/Views/Shared/_AccountLayout.cshtml"; 
}

<div class="card border-0 shadow-sm rounded-3 h-100 mt-4 mb-5">
    <div class="card-body p-4">
        <h4 class="fw-bold mb-1">Đổi Mật Khẩu</h4>
        <p class="text-muted mb-4">Để bảo mật tài khoản, vui lòng không chia sẻ mật khẩu cho người khác</p>
        <hr class="mb-4">

        @if (TempData["SuccessMessage"] != null)
        {
            <div class="alert alert-success alert-dismissible fade show" role="alert">
                <i class="bi bi-check-circle-fill me-2"></i> @TempData["SuccessMessage"]
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
        }

        <form asp-action="DoiMatKhau" asp-controller="TaiKhoan" method="post" style="max-width: 500px;">
            @Html.AntiForgeryToken()

            <div class="mb-3">
                <label class="form-label fw-semibold">Mật khẩu hiện tại</label>
                <input type="password" asp-for="MatKhauCu" name="MatKhauCu" class="form-control" placeholder="Nhập mật khẩu hiện tại">
                <span asp-validation-for="MatKhauCu" class="text-danger small"></span>
            </div>

            <div class="mb-3">
                <label class="form-label fw-semibold">Mật khẩu mới</label>
                <input type="password" asp-for="MatKhauMoi" name="MatKhauMoi" class="form-control" placeholder="Nhập mật khẩu mới">
                <span asp-validation-for="MatKhauMoi" class="text-danger small"></span>
            </div>

            <div class="mb-4">
                <label class="form-label fw-semibold">Xác nhận mật khẩu mới</label>
                <input type="password" asp-for="XacNhanMatKhau" name="XacNhanMatKhau" class="form-control" placeholder="Nhập lại mật khẩu mới">
                <span asp-validation-for="XacNhanMatKhau" class="text-danger small"></span>
            </div>

            <button type="submit" class="btn btn-danger px-4 py-2" style="background-color: #C92127; border-color: #C92127;">Lưu Thay Đổi</button>
        </form>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}