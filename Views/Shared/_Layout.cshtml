<!DOCTYPE html>
@using Microsoft.AspNetCore.Http
@using System.Text.Json
@using BookStoreManagement.Models 
@{
    // Đọc giỏ hàng từ Session
    var sessionCart = Context.Session.GetString("Cart");
    int totalQuantity = 0;
    
    if (sessionCart != null)
    {
        var cartItems = JsonSerializer.Deserialize<List<CartItem>>(sessionCart);
        if (cartItems != null)
        {
            // Cộng tổng số lượng của tất cả các món trong giỏ
            totalQuantity = cartItems.Sum(x => x.SoLuong);
        }
    }
}
<html lang="vi">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>@ViewData["Title"] - Rổ Sách</title>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css">

    <style>
        :root {
            --fahasa-red: #C92127;
            --fahasa-red-hover: #a81c21;
            --bg-body: #f0f0f0;
        }
        body { background-color: var(--bg-body); font-family: Arial, sans-serif;
        font-size: 14px; }
        .text-fahasa { color: var(--fahasa-red) !important;
        }
        .bg-fahasa { background-color: var(--fahasa-red) !important;
        }
        .btn-fahasa { background-color: var(--fahasa-red); color: white; border: none;
        }
        .btn-fahasa:hover { background-color: var(--fahasa-red-hover); color: white;
        }
        .border-fahasa { border-color: var(--fahasa-red) !important;
        }
        .line-clamp-2 { display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; height: 40px;
        }
        .card-product { transition: all 0.3s ease; border: 1px solid transparent;
        }
        .card-product:hover { box-shadow: 0 0.5rem 1rem rgba(0, 0, 0, 0.15); border-color: var(--fahasa-red);
        }
        .card-product:hover .card-title { color: var(--fahasa-red);
        }
        .scroll-horizontal { overflow-x: auto; flex-wrap: nowrap; -ms-overflow-style: none; scrollbar-width: none;
        }
        .scroll-horizontal::-webkit-scrollbar { display: none;
        }
        .cart-badge { position: absolute; top: -5px; right: -10px; font-size: 0.65rem;
        }

        /* ===== CSS CHO MÀN HÌNH LOAD (PRELOADER) ===== */
        #preloader {
            position: fixed;
            top: 0;
            left: 0;
            width: 100%;
            height: 100vh;
            background-color: #FFDAB9;
            z-index: 9999;
            display: flex;
            flex-direction: column;
            justify-content: center;
            align-items: center;
            transition: opacity 0.8s ease-out, visibility 0.8s ease-out;
        }
        #preloader.fade-out {
            opacity: 0;
            visibility: hidden;
        }
        .pulse-logo {
            animation: pulse 1.5s infinite;
        }
        @@keyframes pulse {
            0% { transform: scale(0.95); opacity: 0.8; }
            50% { transform: scale(1.05); opacity: 1; }
            100% { transform: scale(0.95); opacity: 0.8; }
        }

        /* ===== HOVER CHO DANH MỤC & TÌM KIẾM ===== */
        .custom-hover:hover {
            background-color: #f8f9fa !important;
            border-color: #dee2e6 !important;
            transition: 0.2s;
        }
        
        /* Hiệu ứng rê chuột để mở dropdown danh mục */
        .category-hover-wrap:hover .category-menu {
            display: block;
            margin-top: 0;
        }
        .category-hover-wrap .category-menu {
            display: none; 
            min-width: 220px; 
            border-radius: 0 0 8px 8px;
        }
        .category-menu .dropdown-item:hover {
            background-color: #fcebeb;
            color: var(--fahasa-red);
        }
    </style>
</head>
<body>

    <div id="preloader">
        <div class="d-flex align-items-center gap-3 pulse-logo mb-4">
            <img src="/images/logo.png" alt="Logo STORY TOT" style="width: 80px; height: auto; object-fit: contain;">
            <div class="d-flex flex-column align-items-start text-white">
                <h1 class="m-0 fw-bold" style="letter-spacing: -1px; line-height: 1; font-size: 3rem;">
                 STORY TOT
                </h1>
                <span style="font-size: 18px; margin-top: 5px; color: #a1a1aa;">
                    Small hands, Big tales
                </span>
            </div>
        </div>
        
        <p class="text-center fw-semibold mt-3" style="color: #52525b; max-width: 500px; font-size: 1.1rem;">
        Where little stories grow big dreams
        </p>
    </div>
    
    <header class="bg-white py-3 shadow-sm sticky-top">
        <div class="container">
            <div class="row align-items-center">
                <div class="col-12 col-md-3 mb-3 mb-md-0 text-center text-md-start">
                        <a href="/Saches" class="text-decoration-none d-flex align-items-center gap-2">
                            <img src="/images/logo.png" alt="Logo STORY TOT" style="width: 50px; height: auto; object-fit: contain;">
                            <div class="d-flex flex-column align-items-start">
                                <h2 class="m-0 fw-bold text-dark" style="letter-spacing: -1px; line-height: 1;">
                                    STORY TOT
                                </h2>
                                <span class="text-secondary" style="font-size: 14px; margin-top: 4px; font-weight: 500;">
                                    Small hands, Big tales
                                </span>
                            </div>
                        </a>
                </div>
                
                <div class="col-12 col-md-6 mb-3 mb-md-0">
                    <form asp-controller="Saches" asp-action="Index" method="get" class="position-relative">
                        
                        <div class="input-group bg-white" style="border: 2px solid var(--fahasa-red) !important; border-radius: 8px;">
                            
                            <div class="dropdown category-hover-wrap bg-light" style="border-right: 1px solid #dee2e6; border-top-left-radius: 6px; border-bottom-left-radius: 6px;">
                                <button class="btn btn-light h-100 px-3 fw-bold text-dark border-0" type="button" 
                                        style="background-color: #f8f9fa; border-top-left-radius: 6px; border-bottom-left-radius: 6px; box-shadow: none;">
                                    <i class="bi bi-grid-3x3-gap"></i> Danh Mục
                                </button>
                                
                                <ul class="dropdown-menu border-0 shadow-lg category-menu py-2 mt-0">
                                    <li>
                                        <a class="dropdown-item py-2 fw-semibold" href="/Saches?loai=TrongNuoc">Sách Trong Nước</a>
                                    </li>
                                    <li>
                                        <a class="dropdown-item py-2 fw-semibold" href="/Saches?loai=NuocNgoai">Sách Nước Ngoài</a>
                                    </li>
                                    <li><hr class="dropdown-divider"></li>
                                    <li>
                                        <a class="dropdown-item py-2 fw-bold text-danger" href="/Saches?loai=TatCa">
                                            <i class="bi bi-list-ul me-1"></i> Tất Cả Danh Mục
                                        </a>
                                    </li>
                                </ul>
                            </div>

                            <input type="text" id="searchInput" name="searchString" class="form-control border-0 shadow-none py-2" 
                                placeholder="Tìm kiếm sách, tác giả, nhà xuất bản..." 
                                autocomplete="off" value="@ViewData["CurrentFilter"]">
                            
                            <button class="btn btn-fahasa px-4 border-0" type="submit" style="border-top-right-radius: 6px; border-bottom-right-radius: 6px;">
                                <i class="bi bi-search"></i>
                            </button>
                        </div>

                        <div id="suggestionBox" class="list-group position-absolute w-100 mt-1" 
                            style="z-index: 1050; top: 100%; display: none; box-shadow: 0 4px 8px rgba(0,0,0,0.15); border-radius: 8px;">
                        </div>

                    </form>
                </div>
          
                <div class="col-12 col-md-3 d-flex justify-content-center justify-content-md-end gap-4 text-secondary">
            
                    <a asp-controller="Cart" asp-action="Index" class="text-decoration-none text-dark text-center mx-2 position-relative d-inline-block">
                        <div class="position-relative d-inline-block">
                            <i class="bi bi-cart fs-4"></i> 
                          
                            @if (totalQuantity > 0)
                            {
                                <span class="position-absolute top-0 start-100 translate-middle badge rounded-pill 
                                bg-warning text-dark" style="font-size: 0.7rem; transform: translate(-30%, -30%) !important;">
                                    @totalQuantity
                                </span>
                         
                            }
                        </div>
                        <div class="small mt-1 text-muted">Giỏ hàng</div>
                    </a>
                    
                    @if (User.Identity != null && User.Identity.IsAuthenticated)
                    {
                        <div class="dropdown text-center mt-1">
                            <a href="#" class="text-decoration-none text-dark d-block" data-bs-toggle="dropdown" aria-expanded="false">
                                <i class="bi bi-person-check-fill text-success fs-4"></i>
                                <div class="d-none d-md-block fw-bold text-truncate" style="font-size: 11px; max-width: 80px;">
                                    @User.Identity.Name
                                </div>
                            </a>
                            <ul class="dropdown-menu dropdown-menu-end shadow border-0 mt-2">
                                @if (User.IsInRole("Admin"))
                                {
                                    <li>
                                        <a class="dropdown-item text-danger fw-bold py-2" href="/Admin/Home/Index">
                                            <i class="bi bi-gear-fill me-2"></i>Vào Admin Panel
                                        </a>
                                    </li>
                                    <li><hr class="dropdown-divider"></li>
                                }
                                
                                <li>
                                    <a class="dropdown-item py-2 fw-semibold" href="/TaiKhoan/HoSoCaNhan">
                                        <i class="bi bi-person-circle text-primary me-2"></i>Tài khoản của tôi
                                    </a>
                                </li>
                                <li><hr class="dropdown-divider"></li>
                                <li>
                                    <a class="dropdown-item py-2" href="/Account/Logout">
                                        <i class="bi bi-box-arrow-right me-2"></i>Đăng xuất
                                    </a>
                                </li>
                            </ul>
                        </div>
                    }
                    else
                    {
                        <a href="/Account/Login" class="text-decoration-none text-dark text-center mt-1 d-block">
                            <i class="bi bi-person fs-4"></i>
                            <div class="d-none d-md-block" style="font-size: 11px; white-space: nowrap;">Đăng nhập</div>
                        </a>
                    }
                    </div>
            </div>
        </div>
    </header>

    <div class="container-fluid p-0 mt-4">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <footer class="bg-white border-top mt-5 pt-5 pb-3">
        <div class="container">
            <div class="row g-4">
           
                <div class="col-12 col-md-3">
                    <div class="d-flex align-items-center gap-2 mb-3">
                        <img src="/images/logo.png" alt="Logo STORY TOT" style="width: 50px; height: auto; object-fit: contain;">

                        <div class="d-flex flex-column align-items-start">
                            <h3 class="m-0 fw-bold text-dark" style="letter-spacing: -1px; line-height: 1;">
                                STORY TOT
                            </h3>
                            <span class="text-secondary" style="font-size: 14px; margin-top: 4px; font-weight: 500;">
                                Small hands, Big tales
                            </span>
                        </div>
          
                    </div>
                    <p class="text-muted small mb-3">236B Lê Văn Sỹ, Phường Tân Sơn Hòa, TP. Hồ Chí Minh<br>Công Ty Cổ Phần Phát Hành Sách - STORY TOT</p>
                    <div class="d-flex gap-3 fs-5">

                        <a href="https://www.facebook.com/hcmunre" target="_blank">
                            <i class="bi bi-facebook text-primary" style="cursor: pointer;"></i>
                        </a>

                        <a href="https://youtube.com/@@hcmunre-aihoctainguyenvamo6444" target="_blank">
                            <i class="bi bi-youtube text-danger" style="cursor: pointer;"></i>
                        </a>

                    </div>
                </div>
                <div class="col-12 col-md-3">
                    <h6 class="fw-bold mb-3">DỊCH VỤ</h6>
                    <ul class="list-unstyled text-muted small lh-lg">
             
                        <li><a asp-controller="Saches" asp-action="DieuKhoanSuDung" class="text-decoration-none text-muted">Điều khoản sử dụng</a></li>
                        <li><a asp-controller="Saches" asp-action="BaoMatThanhToan" class="text-decoration-none text-muted">Chính sách bảo mật</a></li>
                    </ul>
                </div>
                <div 
                class="col-12 col-md-3">
                    <h6 class="fw-bold mb-3">HỖ TRỢ</h6>
                    <ul class="list-unstyled text-muted small lh-lg">
                        <li><a asp-controller="Saches" asp-action="DoiTra" class="text-decoration-none text-muted">Chính sách đổi trả - hoàn tiền</a></li>
                   
                        <li><a asp-controller="Saches" asp-action="PhuongThucVanChuyen" class="text-decoration-none text-muted">Phương thức vận chuyển</a></li>
                    </ul>
                </div>
                <div class="col-12 col-md-3">
                    <h6 class="fw-bold mb-3">LIÊN HỆ</h6>
            
                    <div class="text-fahasa fw-bold fs-4 mb-2 d-flex align-items-center">
                        <i class="bi bi-telephone-fill me-2 fs-5"></i> 1900 969696
                    </div>
                    <p class="text-muted small mb-0">cskh@storytot.io.vn</p>
             
                </div>
            </div>
            <hr class="mt-4 mb-3 text-muted">
            <div class="text-center text-muted" style="font-size: 0.85rem;">
                <p class="mb-1">&copy; 2026 <strong>STORY TOT BookStore</strong>. All rights reserved.</p>
                <p class="mb-0">
                    <em>Website được xây dựng bởi <strong>To La Nhuc</strong>. Mọi dữ liệu trên website chỉ mang tính chất minh họa và phục vụ giáo dục.</em>
                </p>
            </div>
        </div>
    </footer>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
    
    <script>
        // Khi toàn bộ trang web (ảnh, text...) đã load xong
        window.addEventListener('load', function() {
            // Đặt thời gian trễ (ở đây mình để 1.5 giây = 1500ms) để người dùng kịp nhìn thấy logo
            setTimeout(function() {
                // Thêm class 'fade-out' để làm mờ màn hình load
                document.getElementById('preloader').classList.add('fade-out');
                
                // Mẹo: Sau khi mờ đi (tốn 0.8s theo CSS), ta ẩn hẳn nó đi để không chắn thao tác click của người dùng
                setTimeout(function(){
                    document.getElementById('preloader').style.display = 'none';
                }, 800);

            }, 1500);
        });

        // Gợi ý tìm kiếm
        document.getElementById('searchInput').addEventListener('input', function () {
        var keyword = this.value;
        var box = document.getElementById('suggestionBox');

        if (keyword.length < 2) {
            box.style.display = 'none';
            return;
        }

        fetch('/Saches/GoiYTimKiem?term=' + encodeURIComponent(keyword))
            .then(response => response.json())
            .then(data => {
                box.innerHTML = ''; 
                
                if (data.goiY.length > 0 || data.sanPham.length > 0) {
                    // Tạo một khung nền trắng bao quanh
                    let htmlContent = '<div class="p-3 bg-white border rounded shadow-lg">';

                    // --- PHẦN 1: GỢI Ý TỪ KHÓA ---
                    if (data.goiY.length > 0) {
                        htmlContent += '<h6 class="text-muted fw-bold mb-3"><i class="bi bi-clock-history"></i> Gợi ý</h6>';
                        htmlContent += '<div class="d-flex flex-wrap gap-2 mb-4">';
                        data.goiY.forEach(text => {
                            htmlContent += `<span class="badge bg-light text-dark border p-2 fw-normal" 
                                            style="cursor:pointer; font-size: 0.9rem;" 
                                            onclick="chonGoiY('${text}')">${text}</span>`;
                        });
                        htmlContent += '</div>';
                    }

                    // --- PHẦN 2: SẢN PHẨM ---
                    if (data.sanPham.length > 0) {
                        htmlContent += '<h6 class="text-muted fw-bold mb-3"><i class="bi bi-graph-up-arrow"></i> Sản phẩm</h6>';
                        // Dùng Grid chia thành 2 cột hoặc 3 cột tùy màn hình
                        htmlContent += '<div class="row g-2">';
                        data.sanPham.forEach(sp => {
                            htmlContent += `
                                <div class="col-12 col-md-6">
                                    <a href="/Saches/Details/${sp.id}" class="text-decoration-none text-dark d-flex align-items-center p-2 border rounded border-light bg-light custom-hover">
                                        <img src="${sp.hinhAnh}" style="width: 45px; height: 60px; object-fit: cover; margin-right: 12px; border-radius: 4px;" alt="${sp.tenSach}">
                                        <span style="font-size: 0.9rem; font-weight: 500; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden;">${sp.tenSach}</span>
                                    </a>
                                </div>`;
                        });
                        htmlContent += '</div>';
                    }

                    htmlContent += '</div>'; // Đóng khung
                    box.innerHTML = htmlContent;
                    box.style.display = 'block';
                } else {
                    box.style.display = 'none';
                }
            });
    });

    // Hàm xử lý khi khách hàng bấm vào mấy cái tag chữ (Badge)
    function chonGoiY(text) {
        var input = document.getElementById('searchInput');
        input.value = text; // Điền chữ vào ô
        document.getElementById('suggestionBox').style.display = 'none'; // Ẩn hộp
        input.closest('form').submit(); // Tự động tìm kiếm luôn
    }

    // Bấm ra ngoài khoảng trống thì ẩn menu đi
    document.addEventListener('click', function(e) {
        if (!document.getElementById('searchInput').contains(e.target) && !document.getElementById('suggestionBox').contains(e.target)) {
            document.getElementById('suggestionBox').style.display = 'none';
        }
    });
    </script>

    @await RenderSectionAsync("Scripts", required: false)

</body>
</html>