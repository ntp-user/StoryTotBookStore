@model BookStoreManagement.Models.Sach

@{
    ViewData["Title"] = "Sửa thông tin sách";
}

<div class="container mt-4">
    <h2>Sửa thông tin sách</h2>
    <hr />
    
    <div class="row">
        <div class="col-md-5">
            <form asp-action="Edit">
                
                <input type="hidden" asp-for="MaSach" />
                
                <div class="mb-3">
                    <label asp-for="TenSach" class="form-label">Tên Sách</label>
                    <input asp-for="TenSach" class="form-control" />
                    <span asp-validation-for="TenSach" class="text-danger"></span>
                </div>
                
                <div class="mb-3">
                    <label asp-for="TacGia" class="form-label">Tác Giả</label>
                    <input asp-for="TacGia" class="form-control" />
                    <span asp-validation-for="TacGia" class="text-danger"></span>
                </div>
                
                <div class="mb-3">
                    <label asp-for="GiaBan" class="form-label">Giá (VNĐ)</label>
                    <input asp-for="GiaBan" class="form-control" type="number" step="0.01" />
                    <span asp-validation-for="GiaBan" class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="HinhAnhUrl" class="form-label">Tên File Hình Ảnh (VD: sach1.jpg)</label>
                    <input asp-for="HinhAnhUrl" class="form-control" />
                    <span asp-validation-for="HinhAnhUrl" class="text-danger"></span>
                </div>
                
                <div class="mt-4">
                    <input type="submit" value="Lưu thay đổi" class="btn btn-warning" />
                    <a asp-action="Index" class="btn btn-secondary ms-2">Hủy bỏ</a>
                </div>
                
            </form>
        </div>
    </div>
</div> 

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}