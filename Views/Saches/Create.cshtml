@model BookStoreManagement.Models.Sach

@{
    ViewData["Title"] = "Thêm sách mới";
}

<div class="container mt-4 pb-5">
    <div class="row justify-content-center">
        <div class="col-md-8 col-lg-6">
            <div class="card shadow-sm border-0" style="border-radius: 12px;">
                <div class="card-header bg-white border-bottom-0 pt-4 pb-0 text-center">
                    <h3 class="fw-bold" style="color: #C92127;">
                        <i class="bi bi-journal-plus me-2"></i> Thêm sách mới
                    </h3>
                    <p class="text-muted small">Nhập thông tin và tải ảnh bìa sách lên hệ thống</p>
                </div>
                
                <div class="card-body p-4">
                    <!-- QUAN TRỌNG: Phải có enctype="multipart/form-data" để up file -->
                    <form asp-action="Create" enctype="multipart/form-data">
                        <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
                        
                        <div class="mb-3">
                            <label asp-for="TenSach" class="form-label fw-semibold">Tên Sách <span class="text-danger">*</span></label>
                            <input asp-for="TenSach" class="form-control" placeholder="Ví dụ: Đắc Nhân Tâm" required />
                            <span asp-validation-for="TenSach" class="text-danger"></span>
                        </div>
                        
                        <div class="mb-3">
                            <label asp-for="TacGia" class="form-label fw-semibold">Tác Giả</label>
                            <input asp-for="TacGia" class="form-control" placeholder="Ví dụ: Dale Carnegie" />
                            <span asp-validation-for="TacGia" class="text-danger"></span>
                        </div>
                        
                        <div class="mb-3">
                            <label asp-for="GiaBan" class="form-label fw-semibold">Giá Bán (VNĐ) <span class="text-danger">*</span></label>
                            <div class="input-group">
                                <input asp-for="GiaBan" class="form-control" type="number" step="1000" placeholder="Ví dụ: 85000" required />
                                <span class="input-group-text">đ</span>
                            </div>
                            <span asp-validation-for="GiaBan" class="text-danger"></span>
                        </div>

                        <!-- INPUT FILE CHO PHÉP TẢI ẢNH TỪ MÁY TÍNH -->
                        <div class="mb-4">
                            <label asp-for="ImageUpload" class="form-label fw-semibold">Tải Ảnh Bìa (Từ máy tính)</label>
                            <input asp-for="ImageUpload" class="form-control" type="file" accept="image/*" />
                            <span asp-validation-for="ImageUpload" class="text-danger"></span>
                            <div class="form-text text-muted" style="font-size: 13px; mt-2">
                                <i class="bi bi-info-circle text-primary"></i> Hình ảnh sẽ được tự động lưu vào thư mục <code>wwwroot/images</code>
                            </div>
                        </div>
                        
                        <hr class="text-muted my-4">

                        <div class="d-grid gap-2 d-md-flex justify-content-md-end">
                            <a asp-action="Index" class="btn btn-light border px-4">
                                <i class="bi bi-arrow-left me-1"></i> Quay lại
                            </a>
                            <button type="submit" class="btn text-white px-4" style="background-color: #C92127;">
                                <i class="bi bi-save me-1"></i> Lưu Sách Này
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}

