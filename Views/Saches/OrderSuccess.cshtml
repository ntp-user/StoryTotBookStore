@{
    ViewData["Title"] = "Đặt hàng thành công";
}

<div class="container mt-5 mb-5 text-center" style="min-height: 50vh;">
    <div class="row justify-content-center">
        <div class="col-md-7">
            <div class="card shadow-lg border-0 rounded-4 p-5">
                <i class="bi bi-check-circle-fill text-success mb-3" style="font-size: 6rem;"></i>
                
                <h2 class="fw-bold text-success mb-3">ĐẶT HÀNG THÀNH CÔNG!</h2>
                <p class="text-muted fs-5 mb-2">Cảm ơn bạn đã mua sắm tại cửa hàng của chúng tôi.</p>
                <p class="mb-4">Đơn hàng của bạn đã được gửi tới hệ thống và <strong>đang chờ Admin duyệt</strong>. Bạn nhớ chú ý điện thoại để chúng tôi liên lạc xác nhận giao hàng nhé!</p>
                
                <div class="d-flex justify-content-center gap-3">
                    <a asp-controller="Saches" asp-action="Index" class="btn btn-outline-danger px-4 py-2 rounded-pill fw-bold">
                        <i class="bi bi-house-door"></i> Về Trang Chủ
                    </a>
                    <a asp-controller="Saches" asp-action="Index" class="btn btn-danger px-4 py-2 rounded-pill fw-bold" style="background-color: #C92127;">
                        <i class="bi bi-cart-plus"></i> Tiếp tục mua sắm
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>