@model IEnumerable<BookStoreManagement.Models.Sach>
@{
    ViewData["Title"] = "Quản lý Sách";
    // Tạm thời để trống Layout để test, hoặc nếu bạn có Layout Admin thì gán vào đây
    // Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml"; 
}

<style>
    /* Giới hạn text cột mô tả chỉ hiện tối đa 2 dòng cho đỡ vỡ bảng */
    .mo-ta-ngan {
        max-width: 250px;
        display: -webkit-box;
        -webkit-line-clamp: 2;
        -webkit-box-orient: vertical;
        overflow: hidden;
        text-overflow: ellipsis;
        color: #adb5bd; /* Màu xám nhạt cho text mô tả */
    }
</style>

<div class="container-fluid mt-4 text-white">
    
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2 class="text-info fw-bold m-0"><i class="bi bi-book"></i> QUẢN LÝ SÁCH</h2>
        <a asp-action="Create" class="btn btn-success fw-bold px-4 shadow">+ Thêm sách mới</a>
    </div>

    <div class="table-responsive bg-dark p-3 rounded-4 shadow">
        <table class="table table-dark table-hover table-borderless align-middle mb-0">
            <thead style="border-bottom: 2px solid #495057;">
                <tr>
                    <th class="text-center" style="width: 5%;">ID</th>
                    <th style="width: 10%;">Hình Ảnh</th>
                    <th style="width: 20%;">Tên Sách</th>
                    <th style="width: 12%;">Loại Sách</th>
                    <th style="width: 12%;">Giá Bán</th>
                    <th style="width: 25%;">Mô Tả</th>
                    <th class="text-center" style="width: 16%;">Thao tác</th>
                </tr>
            </thead>
            <tbody>
                @if(Model != null && Model.Any())
                {
                    foreach (var item in Model)
                    {
                        <tr style="border-bottom: 1px solid #2b3035;">
                            <td class="text-center text-light fw-bold">@item.MaSach</td>
                            <td>
                                @if(!string.IsNullOrEmpty(item.HinhAnhUrl))
                                {
                                    <img src="@item.HinhAnhUrl" alt="@item.TenSach" class="rounded" style="width: 50px; height: 70px; object-fit: cover; border: 1px solid #495057;" />
                                }
                            </td>
                            <td class="fw-bold text-white">@item.TenSach</td>
                            <td>
                                @if (item.LoaiSach == "Trong Nuoc")
                                {
                                    <span class="badge bg-success">Trong Nước</span>
                                }
                                else if (item.LoaiSach == "Nuoc Ngoai")
                                {
                                    <span class="badge bg-primary">Nước Ngoài</span>
                                }
                                else
                                {
                                    <span class="badge bg-secondary">Chưa rõ</span>
                                }
                            </td>
                            <td class="text-warning fw-bold">@item.GiaBan.ToString("N0") đ</td>
                            
                            <td><div class="mo-ta-ngan">@item.MoTa</div></td>
                            
                            <td>
                                <div class="d-flex justify-content-center gap-2">
                                    <a asp-action="Edit" asp-route-id="@item.MaSach" class="btn btn-sm btn-outline-warning" title="Sửa"><i class="bi bi-pencil-square"></i> Sửa</a>
                                    <a asp-action="Details" asp-route-id="@item.MaSach" class="btn btn-sm btn-outline-info" title="Chi tiết"><i class="bi bi-info-circle"></i> Chi tiết</a>
                                    <a asp-action="Delete" asp-route-id="@item.MaSach" class="btn btn-sm btn-outline-danger" title="Xóa"><i class="bi bi-trash"></i> Xóa</a>
                                </div>
                            </td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="7" class="text-center py-5 text-muted">
                            <i class="bi bi-inbox fs-1 d-block mb-3"></i>
                            Chưa có cuốn sách nào trong kho.
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>