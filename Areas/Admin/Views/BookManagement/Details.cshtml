@model BookStoreManagement.Models.Sach
@{
    ViewData["Title"] = "Chi tiết sách";
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml"; // Đồng bộ Layout Admin
}

<div class="container-fluid mt-4 text-white">
    
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2 class="text-info fw-bold m-0"><i class="bi bi-info-circle"></i> CHI TIẾT SÁCH</h2>
        <a asp-action="Index" class="btn btn-outline-light"><i class="bi bi-arrow-left"></i> Quay lại danh sách</a>
    </div>

    <div class="card bg-dark border-0 shadow rounded-4" style="border: 1px solid #343a40 !important;">
        <div class="card-body p-4">
            <div class="row">
                
                <div class="col-md-4 text-center mb-4 mb-md-0">
                    <div class="p-3 border border-secondary rounded-4 h-100 d-flex align-items-center justify-content-center" style="background-color: #212529;">
                        @if (!string.IsNullOrEmpty(Model.HinhAnhUrl))
                        {
                            <img src="@Model.HinhAnhUrl" alt="@Model.TenSach" class="img-fluid rounded shadow" style="max-height: 400px; object-fit: contain; border: 4px solid #fff;" />
                        }
                        else
                        {
                            <div class="text-muted p-5">
                                <i class="bi bi-image fs-1 d-block mb-3"></i>
                                <span class="fst-italic">Chưa có hình ảnh minh họa</span>
                            </div>
                        }
                    </div>
                </div>

                <div class="col-md-8 px-md-4">
                    <h3 class="text-warning fw-bold mb-3">@Model.TenSach</h3>
                    <hr class="border-secondary mb-4" />
                    
                    <dl class="row" style="font-size: 1.1rem;">
                        <dt class="col-sm-3 text-white mb-3">Mã Sách:</dt>
                        <dd class="col-sm-9 fw-bold text-light mb-3">#@Model.MaSach</dd>

                        <dt class="col-sm-3 text-white mb-3">Phân Loại:</dt>
                        <dd class="col-sm-9 mb-3">
                            @if (Model.LoaiSach == "Trong Nuoc")
                            {
                                <span class="badge bg-success px-3 py-2">Trong Nước</span>
                            }
                            else if (Model.LoaiSach == "Nuoc Ngoai")
                            {
                                <span class="badge bg-primary px-3 py-2">Nước Ngoài</span>
                            }
                            else
                            {
                                <span class="badge bg-secondary px-3 py-2">@(string.IsNullOrEmpty(Model.LoaiSach) ? "Chưa cập nhật" : Model.LoaiSach)</span>
                            }
                        </dd>

                        <dt class="col-sm-3 text-white mb-3">Tác Giả:</dt>
                        <dd class="col-sm-9 text-light mb-3">@(string.IsNullOrEmpty(Model.TacGia) ? "Đang cập nhật..." : Model.TacGia)</dd>

                        <dt class="col-sm-3 text-white mb-3">Giá Bán:</dt>
                        <dd class="col-sm-9 text-warning fw-bold fs-5 mb-3">@Model.GiaBan.ToString("N0") VNĐ</dd>

                        <dt class="col-sm-3 text-white mb-3">Mô Tả:</dt>
                        <dd class="col-sm-9 text-light mb-3" style="line-height: 1.8; text-align: justify;">
                            @(string.IsNullOrEmpty(Model.MoTa) ? "Chưa có bài viết mô tả cho cuốn sách này." : Model.MoTa)
                        </dd>
                    </dl>

                    <div class="mt-5 pt-4 border-top border-secondary d-flex gap-2">
                        <a asp-action="Edit" asp-route-id="@Model.MaSach" class="btn btn-warning px-4 fw-bold shadow">
                            <i class="bi bi-pencil-square"></i> Chỉnh sửa
                        </a>
                        <a asp-action="Delete" asp-route-id="@Model.MaSach" class="btn btn-outline-danger px-4 shadow">
                            <i class="bi bi-trash"></i> Xóa
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>