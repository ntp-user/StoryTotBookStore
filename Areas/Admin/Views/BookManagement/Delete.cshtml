@model BookStoreManagement.Models.Sach
@{
    ViewData["Title"] = "Xóa sách";
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml"; // Đồng bộ Layout Admin
}

<div class="container-fluid mt-4 text-white">
    
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2 class="text-danger fw-bold m-0"><i class="bi bi-trash-fill"></i> XÓA SÁCH</h2>
        <a asp-action="Index" class="btn btn-outline-light"><i class="bi bi-arrow-left"></i> Quay lại</a>
    </div>

    <div class="row justify-content-center mt-2">
        <div class="col-md-8 col-lg-7">
            
            <div class="alert alert-danger shadow-sm border-0 d-flex align-items-center mb-4 rounded-4" role="alert">
                <i class="bi bi-exclamation-triangle-fill text-danger me-3" style="font-size: 2.5rem;"></i>
                <div>
                    <h5 class="alert-heading mb-1 fw-bold text-danger">BẠN CÓ CHẮC CHẮN MUỐN XÓA?</h5>
                    <p class="mb-0 text-dark">Hành động này <strong>không thể hoàn tác</strong>. Dữ liệu về cuốn sách này sẽ bị xóa vĩnh viễn khỏi hệ thống.</p>
                </div>
            </div>

            <div class="card bg-dark border-0 shadow-lg rounded-4 p-4" style="border: 1px solid #dc3545 !important;">
                <div class="row align-items-center">
                    
                    <div class="col-sm-4 text-center mb-3 mb-sm-0">
                        <div class="p-2 border border-secondary rounded-3" style="background-color: #212529;">
                            @if (!string.IsNullOrEmpty(Model.HinhAnhUrl))
                            {
                                <img src="@Model.HinhAnhUrl" alt="@Model.TenSach" class="img-fluid rounded shadow-sm" style="max-height: 150px; object-fit: contain;" />
                            }
                            else
                            {
                                <div class="text-white p-3">
                                    <i class="bi bi-image fs-1 d-block mb-2"></i>
                                    <span class="small fst-italic">Không có ảnh</span>
                                </div>
                            }
                        </div>
                    </div>
                    
                    <div class="col-sm-8">
                        <h4 class="text-warning fw-bold mb-2">@Model.TenSach</h4>
                        <p class="text-white mb-1 small">Mã sách: <span class="text-light fw-bold">#@Model.MaSach</span></p>
                        <p class="text-white mb-1 small">Tác giả: <span class="text-light">@(string.IsNullOrEmpty(Model.TacGia) ? "Đang cập nhật..." : Model.TacGia)</span></p>
                        <p class="text-white mb-0 small">Giá bán: <span class="text-danger fw-bold fs-5">@Model.GiaBan.ToString("N0") VNĐ</span></p>
                    </div>
                </div>

                <hr class="border-secondary my-4" />

                <form asp-action="Delete" class="d-flex justify-content-end gap-2">
                    <input type="hidden" asp-for="MaSach" />
                    <a asp-action="Index" class="btn btn-secondary px-4 shadow">Hủy bỏ</a>
                    <button type="submit" class="btn btn-danger px-4 fw-bold shadow">
                        <i class="bi bi-trash"></i> Xác nhận Xóa
                    </button>
                </form>
            </div>

        </div>
    </div>
</div>