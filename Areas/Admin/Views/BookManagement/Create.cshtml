@model BookStoreManagement.Models.Sach
@{
    ViewData["Title"] = "Thêm sách mới";
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml"; // Đảm bảo dùng chung Layout Admin
}

<style>
    /* Tuỳ chỉnh màu sắc cho các ô nhập liệu trong nền tối (giống trang Edit) */
    .form-control-dark {
        background-color: #2b3035;
        border: 1px solid #495057;
        color: #f8f9fa;
    }
    .form-control-dark:focus {
        background-color: #343a40;
        border-color: #198754; /* Viền xanh lá khi focus */
        color: #fff;
        box-shadow: 0 0 0 0.25rem rgba(25, 135, 84, 0.25);
    }
    .form-control-dark::placeholder {
        color: #6c757d;
    }
    
    .form-select-dark {
        background-color: #2b3035;
        border: 1px solid #495057;
        color: #f8f9fa;
        background-image: url("data:image/svg+xml,%3csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 16 16'%3e%3cpath fill='none' stroke='%23f8f9fa' stroke-linecap='round' stroke-linejoin='round' stroke-width='2' d='m2 5 6 6 6-6'/%3e%3c/svg%3e");
    }
    .form-select-dark:focus {
        border-color: #198754;
        box-shadow: 0 0 0 0.25rem rgba(25, 135, 84, 0.25);
    }
</style>

<div class="container-fluid mt-4 text-white">
    
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2 class="text-success fw-bold m-0"><i class="bi bi-plus-circle"></i> THÊM SÁCH MỚI</h2>
        <a asp-action="Index" class="btn btn-outline-light"><i class="bi bi-arrow-left"></i> Quay lại</a>
    </div>

    <div class="row">
        <div class="col-md-8 mb-4">
            <div class="card bg-dark border-0 shadow rounded-4 p-4" style="border: 1px solid #343a40 !important;">
                <h5 class="text-info mb-4 border-bottom border-secondary pb-2">Nhập thông tin sách</h5>
                
                <form asp-action="Create" enctype="multipart/form-data" method="post">
                    
                    <div class="row">
                        <div class="col-md-8 mb-3">
                            <label asp-for="TenSach" class="form-label fw-bold text-light">Tên Sách <span class="text-danger">*</span></label>
                            <input asp-for="TenSach" class="form-control form-control-dark" required placeholder="Nhập tên sách..." />
                            <span asp-validation-for="TenSach" class="text-danger small"></span>
                        </div>
                        
                        <div class="col-md-4 mb-3">
                            <label asp-for="LoaiSach" class="form-label fw-bold text-light">Phân Loại <span class="text-danger">*</span></label>
                            <select asp-for="LoaiSach" class="form-select form-select-dark" required>
                                <option value="">-- Chọn loại --</option>
                                <option value="Trong Nuoc">Sách Trong Nước</option>
                                <option value="Nuoc Ngoai">Sách Nước Ngoài</option>
                            </select>
                            <span asp-validation-for="LoaiSach" class="text-danger small"></span>
                        </div>
                    </div>

                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label asp-for="TacGia" class="form-label fw-bold text-light">Tác giả</label>
                            <input asp-for="TacGia" class="form-control form-control-dark" placeholder="Nhập tên tác giả..." />
                            <span asp-validation-for="TacGia" class="text-danger small"></span>
                        </div>

                        <div class="col-md-6 mb-3">
                            <label asp-for="GiaBan" class="form-label fw-bold text-light">Giá Bán (VNĐ) <span class="text-danger">*</span></label>
                            <div class="input-group">
                                <input asp-for="GiaBan" type="number" class="form-control form-control-dark" required placeholder="0" />
                                <span class="input-group-text bg-secondary text-white border-secondary">₫</span>
                            </div>
                            <span asp-validation-for="GiaBan" class="text-danger small"></span>
                        </div>
                    </div>

                    <div class="mb-3">
                        <label asp-for="MoTa" class="form-label fw-bold text-light">Mô tả sách</label>
                        <textarea asp-for="MoTa" class="form-control form-control-dark" rows="4" placeholder="Nhập mô tả chi tiết nội dung cuốn sách..."></textarea>
                        <span asp-validation-for="MoTa" class="text-danger small"></span>
                    </div>

                    <div class="mb-4 p-3 rounded" style="background-color: rgba(25, 135, 84, 0.1); border: 1px dashed #198754;">
                        <label asp-for="ImageUpload" class="form-label fw-bold text-success mb-2"><i class="bi bi-cloud-upload"></i> Tải Ảnh Bìa Lên</label>
                        <input asp-for="ImageUpload" type="file" class="form-control form-control-dark" accept="image/*" />
                        <span asp-validation-for="ImageUpload" class="text-danger small"></span>
                    </div>

                    <div class="d-grid gap-2 d-md-flex justify-content-md-end mt-4 pt-3 border-top border-secondary">
                        <a asp-action="Index" class="btn btn-secondary px-4">Hủy bỏ</a>
                        <button type="submit" class="btn btn-success px-5 fw-bold shadow"><i class="bi bi-plus-circle"></i> Thêm Mới</button>
                    </div>
                </form>
            </div>
        </div>
        
        <div class="col-md-4 mb-4">
            <div class="card bg-dark border-0 shadow rounded-4 p-4 h-100" style="border: 1px solid #343a40 !important;">
                <h5 class="text-secondary mb-4 border-bottom border-secondary pb-2"><i class="bi bi-info-circle"></i> Hướng dẫn nhập</h5>
                <ul class="text-light small" style="line-height: 2; padding-left: 1.2rem;">
                    <li>Các trường có dấu <span class="text-danger">*</span> là bắt buộc nhập.</li>
                    <li><strong>Giá bán</strong> chỉ nhập các con số, không chứa dấu phẩy hay ký tự đặc biệt (ví dụ: 150000).</li>
                    <li><strong>Ảnh bìa</strong> nên có định dạng .jpg hoặc .png, kích thước file không nên quá lớn để trang web load nhanh.</li>
                </ul>
                <div class="mt-auto pt-4 text-center">
                    <i class="bi bi-journal-plus text-secondary opacity-50" style="font-size: 5rem;"></i>
                </div>
            </div>
        </div>
    </div>
</div>