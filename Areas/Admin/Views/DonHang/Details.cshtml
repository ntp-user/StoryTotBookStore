@model BookStoreManagement.Models.DonHang
@{
    ViewData["Title"] = "Chi tiết đơn hàng";
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";
}

<div class="container-fluid mt-4 text-white">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2 class="text-info fw-bold m-0"><i class="bi bi-receipt"></i> CHI TIẾT ĐƠN HÀNG #@Model.MaDH</h2>
        <a asp-action="Index" class="btn btn-outline-light"><i class="bi bi-arrow-left"></i> Quay lại</a>
    </div>

    <div class="row">
        <div class="col-md-4 mb-4">
            <div class="card bg-dark border-0 shadow rounded-4 p-4 h-100" style="border: 1px solid #343a40 !important;">
                <h5 class="text-secondary mb-3 border-bottom border-secondary pb-2">Thông tin Đơn hàng</h5>
                <p class="text-light"><strong>Khách hàng:</strong> <span class="text-info fw-bold">@Model.TenNguoiNhan</span></p>
                <p class="text-light"><strong>SĐT:</strong> @Model.SoDienThoai</p>
                <p class="text-light"><strong>Địa chỉ:</strong> @Model.DiaChiGiaoHang</p>
                <p class="text-light"><strong>Ngày đặt:</strong> @Model.NgayDatHang?.ToString("dd/MM/yyyy HH:mm")</p>
                
                <hr class="border-secondary" />
                <p class="text-light"><strong>Trạng thái:</strong> 
                    @if (Model.TrangThai == 0) { <span class="badge bg-warning text-dark px-2 py-1">Chưa duyệt</span> }
                    else if (Model.TrangThai == 1) { <span class="badge bg-success px-2 py-1">Đã duyệt</span> }
                    else { <span class="badge bg-danger px-2 py-1">Đã từ chối</span> }
                </p>

                @if (Model.TrangThai == 2 && !string.IsNullOrEmpty(Model.LyDoTuChoi))
                {
                    <div class="alert alert-danger p-2 mt-2" style="font-size: 14px;">
                        <strong>Lý do từ chối:</strong> @Model.LyDoTuChoi
                    </div>
                }
            </div>
        </div>

        <div class="col-md-8 mb-4">
            <div class="card bg-dark border-0 shadow rounded-4 p-4" style="border: 1px solid #343a40 !important;">
                <h5 class="text-secondary mb-3 border-bottom border-secondary pb-2">Sản phẩm đã mua</h5>
                
                <div class="table-responsive">
                    <table class="table table-dark table-hover table-borderless align-middle">
                        <thead>
                            <tr style="border-bottom: 2px solid #495057;">
                                <th>Sản phẩm</th>
                                <th>Tên Sách</th>
                                <th class="text-center">Số Lượng</th>
                                <th>Đơn Giá</th>
                                <th>Thành Tiền</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if(Model.ChiTietDonHangs != null)
                            {
                                foreach (var item in Model.ChiTietDonHangs)
                                {
                                    <tr style="border-bottom: 1px solid #2b3035;">
                                        <td>
                                            <img src="@item.Sach?.HinhAnhUrl" class="rounded" style="width: 50px; height: 70px; object-fit: cover; border: 1px solid #495057;" />
                                        </td>
                                        <td class="fw-bold text-light">@item.Sach?.TenSach</td>
                                        <td class="text-center">@item.SoLuong</td>
                                        <td class="text-white">@item.DonGia.ToString("N0") ₫</td>
                                        <td class="text-warning fw-bold">@((item.SoLuong * item.DonGia).ToString("N0")) ₫</td>
                                    </tr>
                                }
                            }
                        </tbody>
                    </table>
                </div>
                
                <h4 class="text-end text-danger fw-bold mt-3">Tổng cộng: @Model.TongTien?.ToString("N0") ₫</h4>

                @if (Model.TrangThai == 0)
                {
                    <div class="d-flex justify-content-end gap-2 mt-4 pt-3 border-top border-secondary">
                        <button type="button" class="btn btn-outline-danger px-4" data-bs-toggle="modal" data-bs-target="#rejectModal">
                            <i class="bi bi-x-circle"></i> Từ chối đơn
                        </button>

                        <form id="form-duyet-@Model.MaDH" asp-action="DuyetDonHang" asp-route-id="@Model.MaDH" method="post">
                            <button type="button" class="btn btn-success px-5 fw-bold" onclick="xacNhanDuyetDon(@Model.MaDH)">
                                <i class="bi bi-check-lg"></i> Duyệt Đơn
                            </button>
                        </form>
                    </div>
                }
            </div>
        </div>
    </div>
</div>

<div class="modal fade" id="rejectModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content bg-dark text-white border-danger" style="border: 2px solid;">
            <div class="modal-header border-secondary">
                <h5 class="modal-title text-danger fw-bold"><i class="bi bi-exclamation-triangle"></i> TỪ CHỐI ĐƠN HÀNG</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <form asp-action="TuChoiDonHang" method="post">
                <div class="modal-body">
                    <input type="hidden" name="id" value="@Model.MaDH" />
                    <div class="mb-3">
                        <label class="form-label text-light">Vui lòng nhập lý do từ chối (Khách hàng sẽ thấy lý do này):</label>
                        <textarea name="lyDoTuChoi" class="form-control" rows="3" style="background-color: #2b3035; color: white; border: 1px solid #8ba7c4;" required placeholder="Ví dụ: Hết hàng, Sai thông tin..."></textarea>
                    </div>
                </div>
                <div class="modal-footer border-secondary">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Hủy bỏ</button>
                    <button type="submit" class="btn btn-danger fw-bold">Xác nhận Từ Chối</button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>

    <script>
        function xacNhanDuyetDon(maDH) {
            Swal.fire({
                title: 'Xác nhận duyệt đơn?',
                text: "Bạn có chắc chắn muốn duyệt đơn hàng #" + maDH + " không?",
                icon: 'question',
                showCancelButton: true,
                confirmButtonColor: '#198754', 
                cancelButtonColor: '#dc3545', 
                confirmButtonText: '<i class="bi bi-check-lg"></i> Đồng ý duyệt',
                cancelButtonText: 'Hủy bỏ',
                background: '#212529', 
                color: '#fff' 
            }).then((result) => {
                if (result.isConfirmed) {
                    // Tự động submit form khi người dùng nhấn Đồng ý
                    document.getElementById('form-duyet-' + maDH).submit();
                }
            })
        }
    </script>
}